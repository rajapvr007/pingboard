PORT=4000
NODE_ENV=development
AWS_REGION=us-east-1

# DynamoDB Configuration
DYNAMODB_TABLE_NAME=PingBoardTable
# Set DYNAMODB_ENDPOINT if running DynamoDB Local (e.g. http://localhost:8000)
# DYNAMODB_ENDPOINT=http://localhost:8000

# AWS Cognito Configuration
COGNITO_USER_POOL_ID=us-east-1_exampleId
COGNITO_CLIENT_ID=exampleClientId

# Development / Testing toggle
# Set to true to bypass live Cognito JWT verification and use a mock user (sub=usr_dev123)
MOCK_AUTH=true
